# qflows with Docker Compose: docker.sh setup (or install) writes docker/.env from this; by hand: cd docker; cp env.example .env; chmod 600 .env, and fill in.
# The passwords go into connection strings: letters and digits only (e.g. openssl rand -hex 24)

# the optional services, on by default: browser (the AI steps' web browser; without it, remove it here and empty NFN_BROWSER_URL),
# mailpit (catches the outgoing mail; with the host's Haraka, remove it)
COMPOSE_PROFILES=browser,mailpit
# with the browser profile: its address for the app (mcp.json)
NFN_BROWSER_URL=http://playwright:8931/mcp

# the host's Haraka (the operator's: README.md, Inbound mail), with compose.mail.yaml in COMPOSE_FILE: Haraka for the app (host.docker.internal, empty: none),
# the database's and the daemon's ports published on the host's 127.0.0.1 for it (nfn.ini: uri, job_port)
HARAKA_HOST=
#MONGO_HOST_PORT=27017
#DAEMON_HOST_PORT=9000

# MongoDB (the mongo container): root (also nfn_admin), the app's user nfn_app, Haraka's nfn_haraka; set before the first start (the users are made then)
MONGO_ROOT_PW=
NFN_APP_PW=
NFN_HARAKA_PW=
MONGO_DB=qflows-db

# the site, for the operator's reverse proxy (HTTPS there: README.md): published on 127.0.0.1:8080; the server name (_: any)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
NGINX_SERVER_NAME=_

# the setup's defaults (/setup): the public address (the proxy's, https://...), the SMTP server (mailpit, 1025; the host's Haraka: host.docker.internal, 25)
BASE_URL=
SMTP_HOST=mailpit
SMTP_PORT=1025
# mailpit's page (the mail it caught), on the host's 127.0.0.1; the messages it keeps
MAILPIT_PORT=8025
MAILPIT_MAX_MESSAGES=5000

# the daemon's port, inside the containers' network (not published)
DAEMON_PORT=9000

# the containers', volumes' and images' prefix (docker.sh setup: qflows-<the folder's name>), one per installation on a host
COMPOSE_PROJECT_NAME=qflows

# the image's user (the volumes' owner); development (compose.dev.yaml): your own (id -u, id -g)
NFN_UID=1000
NFN_GID=1000
# the data's folder (an absolute path): config, logs, var, tmp, bounces (the host's Haraka writes them: its bounce_dir), mongo-data, mailpit in it
# (docker.sh setup: <the user's home>/docker-volumes, the folders made with their owners)
DATA_DIR=
TZ=UTC

# the app's code, cloned in the app image: the repository, its branch, the commit (docker.sh install / update: the branch's head then; empty: the branch)
QFLOWS_REPO=https://github.com/serbanconstantinescu/qflows-core.git
QFLOWS_BRANCH=main
QFLOWS_COMMIT=
# plugins in their own repositories, cloned into the image (docker.sh setup --plugins=regional-ro,regional-eu, the default; none: both empty): "<Name>=<git URL>"
# separated by spaces, and their names for plugins.json (the app turns them on at its start)
QFLOWS_PLUGINS="RegionalRO=https://github.com/serbanconstantinescu/qflows-regional-ro.git RegionalEU=https://github.com/serbanconstantinescu/qflows-regional-eu.git"
NFN_PLUGINS=RegionalRO,RegionalEU
