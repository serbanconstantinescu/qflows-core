# repo root is $HOME - ignore everything by default, then whitelist the project files
/*
/.*

# --- tracked ---
!/.gitignore
!/app/
!/public_html/
!/scripts/
!/app.env.example
!/install.sh
!/docker.sh
!/README.md
!/LICENSE
# Docker Compose: all its files in docker/
!/docker/

# --- never commit (secrets / runtime) ---
app.env
# the compose settings (passwords), next to docker/compose.yaml
/docker/.env
# an installation's own settings (plugins.json, mcp.json, next to app.env, are not whitelisted above)
*.local.php
# plugins kept in their own repositories, cloned into app/plugins/ (each its own git repository): MultiTenant (serbanconstantinescu/qflows-multitenant), RegionalRO (serbanconstantinescu/qflows-regional-ro), RegionalEU (serbanconstantinescu/qflows-regional-eu), SAP (no repository yet)
/app/plugins/MultiTenant/
/app/plugins/RegionalRO/
/app/plugins/SAP/
/app/plugins/RegionalEU/
# tc-lib-pdf and its fonts: downloaded and built by scripts/tc-lib-pdf.sh
/app/pkgs/tc-lib-pdf/
/app/pkgs/.tc-lib-pdf.*
*.key
*.pem
/haraka/
*.log
*.tgz
compliance/
frontend/
etc/
tests/
